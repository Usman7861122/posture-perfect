---
import '../styles/global.css';
import Header from '../components/react/Header';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/react/CookieConsent';
import AssessmentChat from '../components/react/AssessmentChat';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object | object[];
  theme?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
}

const { title, description = site.description, jsonLd, theme, noindex, image = '/images/og-default.jpg', imageAlt = 'The Posture Perfect Wellness Center care team in the clinic' } = Astro.props;
const ogImage = new URL(image, Astro.site).toString();
// Titles: 30-60 characters. Brand suffix is short, and dropped when the title would be too long.
const SUFFIX = ' | Posture Perfect';
const fitTitle = (t?: string) => {
  if (!t) return 'Chiropractor in Dallas & McKinney | Posture Perfect';
  let out = t + SUFFIX;
  if (out.length > 60) out = t;
  if (out.length > 60) {
    const cut = out.slice(0, 60);
    out = cut.slice(0, Math.max(cut.lastIndexOf(' '), 30)).replace(/[\s,:;&|-]+$/, '');
  }
  return out;
};
// Descriptions: 120-155 characters. Long ones are cut at a sentence or word; short ones get a short closing line.
const TAIL = ' Call 972-792-0204 or book online at our Dallas and McKinney offices.';
const fitDescription = (d: string) => {
  d = d.replace(/\s+/g, ' ').trim();
  if (d.length > 155) {
    const cut = d.slice(0, 155);
    const sentence = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('? '));
    d = sentence >= 110 ? cut.slice(0, sentence + 1) : cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s,:;&|-]+$/, '') + '.';
  }
  if (d.length < 120 && (d + TAIL).length <= 155) d += TAIL;
  else if (d.length < 120) d = (d.replace(/[.\s]+$/, '') + '. Posture Perfect Wellness Center, Dallas and McKinney, TX.').slice(0, 155);
  return d;
};
const pageTitle = fitTitle(title);
const metaDescription = fitDescription(description);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d174a" />
    <meta name="google-site-verification" content="c-sQ-qFIRZXhQKyyvI9cbREP3OI3qCi6QoKW4goWct4" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={theme ? `theme-${theme}` : undefined}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-sm focus:bg-ivory-50 focus:px-5 focus:py-3 focus:text-forest-900">
      Skip to content
    </a>
    <Header client:load />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <AssessmentChat client:idle />
    <CookieConsent client:idle />
  </body>
</html>
