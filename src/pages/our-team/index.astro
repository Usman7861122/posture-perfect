---
// Our Providers: lists all providers.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/react/Reveal';
import { site } from '../../data/site';
import { img } from '../../data/images';
import { providers } from '../../data/providers';

const bg = (list: string[]) => list.map((u) => `url(${u})`).join(', ');
const title = 'Our Providers | Chiropractors & Spine Surgeon in Dallas & McKinney, TX';
const desc = 'Meet the providers at Posture Perfect Wellness Center: chiropractors, a pain management specialist and an orthopedic spine surgeon serving Dallas and McKinney, TX.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: desc,
  url: new URL('/our-team/', Astro.site).toString(),
  hasPart: providers.map((p) => ({ '@type': 'Physician', name: p.short, url: new URL(`/our-team/${p.slug}/`, Astro.site).toString() })),
};
---

<BaseLayout title={title} description={desc} jsonLd={jsonLd}>
  <section class="on-dark relative isolate overflow-hidden bg-forest-950 pb-16 pt-36 text-ivory-50 md:pb-24 md:pt-44">
    <div aria-hidden="true" class="parallax-fixed absolute inset-0 -z-20" style={`background-image: ${bg(img.hero)}`}></div>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-r from-forest-950/95 via-forest-950/80 to-forest-950/50"></div>
    <div class="container-page">
      <nav aria-label="Breadcrumb" class="text-xs uppercase tracking-[0.18em] text-ivory-200/70">
        <ol class="flex items-center gap-x-2">
          <li><a href="/" class="hover:text-gold-300">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gold-300" aria-current="page">Our Providers</li>
        </ol>
      </nav>
      <h1 class="mt-10 max-w-3xl text-[clamp(2.25rem,5vw,4.25rem)] leading-[1.05] text-ivory-50">Our providers</h1>
      <span aria-hidden="true" class="my-7 block h-px w-32 bg-gradient-to-r from-gold-400 to-transparent"></span>
      <p class="max-w-xl text-base leading-relaxed text-ivory-100/85 sm:text-lg">Chiropractors, a pain management specialist and an orthopedic spine surgeon, working as one team on one plan for you.</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="btn-gold btn-book">Schedule an Evaluation</a>
        <a href={site.phoneHref} class="btn-outline-light">Call {site.phone}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page space-y-6">
      {providers.map((p, i) => (
        <Reveal client:visible>
          <a href={`/our-team/${p.slug}/`} class:list={['group grid overflow-hidden border border-forest-900/15 bg-ivory-50 transition-all duration-500 hover:border-gold-500 hover:shadow-[0_30px_60px_-35px_rgba(7,26,21,0.55)]', i % 2 === 1 ? 'md:grid-cols-[1fr_320px] lg:grid-cols-[1fr_380px]' : 'md:grid-cols-[320px_1fr] lg:grid-cols-[380px_1fr]']}>
            <span class:list={['relative block min-h-[320px] overflow-hidden bg-forest-800 md:min-h-[360px]', i % 2 === 1 && 'md:order-2']}>
              <img src={p.image} alt={`${p.short}, ${p.role}`} width="600" height="750" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-top grayscale-[35%] transition-all duration-[1200ms] ease-[var(--ease-luxe)] group-hover:scale-105 group-hover:grayscale-0" onerror="this.style.display='none'" />
              <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-forest-950/50 via-transparent to-transparent"></span>
            </span>
            <span class="flex flex-col justify-center p-8 sm:p-12">
              <span class="text-xs font-medium uppercase tracking-[0.25em] text-gold-700">{p.role}</span>
              <span class="mt-3 block font-serif text-4xl leading-tight text-forest-900 sm:text-5xl">{p.name}</span>
              <span aria-hidden="true" class="my-6 block h-px w-24 bg-gradient-to-r from-gold-500 to-transparent"></span>
              <span class="block max-w-xl text-base leading-relaxed text-muted">{p.blurb}</span>
              <span class="mt-8 inline-flex items-center gap-3 text-sm font-medium uppercase tracking-[0.2em] text-forest-900 transition-colors group-hover:text-gold-700">
                View profile <span aria-hidden="true" class="transition-transform duration-500 group-hover:translate-x-2">→</span>
              </span>
            </span>
          </a>
        </Reveal>
      ))}
    </div>
  </section>

  <section class="on-dark relative isolate overflow-hidden py-16 text-center text-ivory-50 md:py-24">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-forest-900"></div>
    <Reveal client:visible className="container-page max-w-3xl">
      <h2 class="display !text-ivory-50">One team. <em class="gold-text">One plan.</em></h2>
      <p class="lead mt-6">Our providers work together, so your care is never split into pieces. Start with an evaluation at our Dallas or McKinney office.</p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/contact" class="btn-gold btn-book">Schedule an Evaluation</a>
        <a href={site.phoneHref} class="btn-outline-light">Call {site.phone}</a>
      </div>
    </Reveal>
  </section>
</BaseLayout>
