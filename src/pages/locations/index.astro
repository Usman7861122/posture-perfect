---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/react/Reveal';
import LocationsMap from '../../components/react/LocationsMap';
import { site } from '../../data/site';
import { img } from '../../data/images';

const bg = (list: string[]) => list.map((u) => `url(${u})`).join(', ');
const title = 'Locations | Dallas & McKinney, TX Offices';
const desc = 'Two offices to serve you: North Dallas Parkway in Dallas and Harroun Street in McKinney, Texas. Hours, directions and phone.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: desc,
  url: new URL('/locations/', Astro.site).toString(),
};
---

<BaseLayout title={title} description={desc} jsonLd={jsonLd}>
  <section class="on-dark relative isolate overflow-hidden bg-forest-950 pb-16 pt-36 text-ivory-50 md:pb-24 md:pt-44">
    <div aria-hidden="true" class="parallax-fixed absolute inset-0 -z-20" style={`background-image: ${bg(img.hero)}`}></div>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-r from-forest-950/95 via-forest-950/80 to-forest-950/50"></div>
    <div class="container-page">
      <nav aria-label="Breadcrumb" class="text-xs uppercase tracking-[0.18em] text-ivory-200/70">
        <ol class="flex items-center gap-x-2">
          <li><a href="/" class="hover:text-gold-300">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gold-300" aria-current="page">Locations</li>
        </ol>
      </nav>
      <h1 class="mt-10 max-w-3xl text-[clamp(2.25rem,5vw,4.25rem)] leading-[1.05] text-ivory-50">Two offices, <em class="gold-text">one team</em></h1>
      <span aria-hidden="true" class="my-7 block h-px w-32 bg-gradient-to-r from-gold-400 to-transparent"></span>
      <p class="max-w-xl text-base leading-relaxed text-ivory-100/85 sm:text-lg">Visit us in Dallas or McKinney. Same providers, same care, same plan built around you.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid gap-6 md:grid-cols-2">
      {site.locations.map((l) => (
        <Reveal client:visible>
          <a href={`/locations/${l.slug}/`} class="group flex h-full flex-col border border-forest-900/15 bg-ivory-50 p-8 transition-all duration-500 hover:-translate-y-1 hover:border-gold-500 hover:shadow-[0_30px_60px_-35px_rgba(7,26,21,0.55)] sm:p-10">
            <span class="text-xs font-medium uppercase tracking-[0.25em] text-gold-700">{l.name}</span>
            <span class="mt-3 block font-serif text-4xl text-forest-900 sm:text-5xl">{l.city}, TX</span>
            <span aria-hidden="true" class="my-6 block h-px w-24 bg-gradient-to-r from-gold-500 to-transparent"></span>
            <address class="not-italic leading-relaxed text-muted">{l.street}<br />{l.cityLine}</address>
            <p class="mt-4 text-sm leading-relaxed text-muted">Mon, Wed, Thu 8 AM – 6 PM<br />Tue, Fri 8 AM – 2 PM<br />Sat, Sun closed</p>
            <span class="mt-auto inline-flex items-center gap-3 pt-8 text-sm font-medium uppercase tracking-[0.2em] text-forest-900 transition-colors group-hover:text-gold-700">
              View office <span aria-hidden="true" class="transition-transform duration-500 group-hover:translate-x-2">→</span>
            </span>
          </a>
        </Reveal>
      ))}
    </div>
  </section>

  <section class="section bg-ivory-100 pt-0">
    <div class="container-page">
      <LocationsMap client:visible />
    </div>
  </section>

  <section class="on-dark relative isolate overflow-hidden py-16 text-center text-ivory-50 md:py-24">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-forest-900"></div>
    <Reveal client:visible className="container-page max-w-3xl">
      <h2 class="display !text-ivory-50">Not sure <em class="gold-text">which to pick?</em></h2>
      <p class="lead mt-6">Call us. We will help you choose the office and the time that fit your day.</p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/contact" class="btn-gold btn-book">Schedule an Evaluation</a>
        <a href={site.phoneHref} class="btn-outline-light">Call {site.phone}</a>
      </div>
    </Reveal>
  </section>
</BaseLayout>
