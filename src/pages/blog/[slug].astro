---
// Article page. Only posts with a file in src/data/posts/ get a page here.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/react/Reveal';
import { site } from '../../data/site';
import { posts, oldSite, fmtDate, postUrl } from '../../data/blog';

export async function getStaticPaths() {
  const files = import.meta.glob('../../data/posts/*.md', { eager: true }) as Record<string, any>;
  return Object.entries(files).map(([path, mod]) => ({
    params: { slug: path.split('/').pop()!.replace('.md', '') },
    props: { Content: mod.Content, fm: mod.frontmatter },
  }));
}

const { Content, fm } = Astro.props;
const slug = Astro.params.slug!;
const meta = posts.find((p) => p.slug === slug);
const image = meta?.image || (fm.oldImage ? `${oldSite}/wp-content/uploads/${fm.oldImage}` : '');
const date = String(fm.date).slice(0, 10);
const url = new URL(`/blog/${slug}/`, Astro.site).toString();
const related = posts.filter((p) => p.slug !== slug && p.tag === fm.tag).slice(0, 3);
const same = (related.length ? related : posts.filter((p) => p.slug !== slug)).slice(0, 3);
const full = new Set(Object.keys(import.meta.glob('../../data/posts/*.md')).map((p) => p.split('/').pop()!.replace('.md', '')));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: fm.title,
      description: fm.excerpt,
      datePublished: date,
      author: { '@type': 'Person', name: fm.author },
      publisher: { '@type': 'Organization', name: site.name },
      mainEntityOfPage: url,
      ...(image ? { image } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: fm.title, item: url },
      ],
    },
  ],
};
---

<BaseLayout title={fm.title} description={fm.excerpt} jsonLd={jsonLd}>
  <section class="on-dark grain relative isolate overflow-hidden bg-forest-950 pb-14 pt-36 text-ivory-50 md:pb-20 md:pt-44">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_80%_20%,rgba(184,151,90,0.18),transparent_55%)]"></div>
    <div class="container-page max-w-4xl">
      <nav aria-label="Breadcrumb" class="text-xs uppercase tracking-[0.18em] text-ivory-200/70">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li><a href="/" class="hover:text-gold-300">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blog/" class="hover:text-gold-300">Blog</a></li>
        </ol>
      </nav>
      <p class="eyebrow mt-10">{fm.tag}</p>
      <h1 class="mt-4 text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.08] text-ivory-50">{fm.title}</h1>
      <span aria-hidden="true" class="my-6 block h-px w-32 bg-gradient-to-r from-gold-400 to-transparent"></span>
      <p class="text-sm text-ivory-200/80">By {fm.author} · <time datetime={date}>{fmtDate(date)}</time></p>
    </div>
  </section>

  <article class="section">
    <div class="container-page max-w-3xl">
      {image && <img src={image} alt="" width="1200" height="675" class="mb-12 aspect-[16/9] w-full object-cover" onerror="this.style.display='none'" />}
      <div class="post-body"><Content /></div>

      <aside class="mt-14 border border-gold-500/40 bg-ivory-100 p-8 text-center">
        <p class="font-serif text-3xl text-forest-900">Ready to feel better?</p>
        <p class="mt-3 text-muted">Book an evaluation at our Dallas or McKinney office.</p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/contact" class="btn-dark btn-book">Schedule an Evaluation</a>
          <a href={site.phoneHref} class="btn-outline">Call {site.phone}</a>
        </div>
      </aside>
      <p class="mt-8 text-xs leading-relaxed text-muted">This article is for general information and is not medical advice. See our <a href="/medical-disclaimer/" class="underline underline-offset-4 hover:text-gold-700">Medical Disclaimer</a>.</p>
    </div>
  </article>

  <section class="section bg-ivory-100 pt-14">
    <div class="container-page">
      <h2 class="text-center text-3xl text-forest-900">Keep reading</h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {same.map((p) => (
          <li>
            <a href={full.has(p.slug) ? `/blog/${p.slug}/` : postUrl(p.slug)} target={full.has(p.slug) ? undefined : '_blank'} rel={full.has(p.slug) ? undefined : 'noopener'} class="group block h-full border border-forest-900/15 bg-ivory-50 p-6 transition-all duration-500 hover:-translate-y-1 hover:border-gold-500">
              <span class="text-xs uppercase tracking-[0.18em] text-gold-700">{p.tag}</span>
              <span class="mt-3 block font-serif text-2xl leading-snug text-forest-900 group-hover:text-gold-700">{p.title}</span>
              <span class="mt-4 block text-xs uppercase tracking-[0.18em] text-muted">{fmtDate(p.date)}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-10 text-center"><a href="/blog/" class="btn-outline">All Articles</a></div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .post-body { font-size: 1.0625rem; line-height: 1.8; color: var(--color-muted, #4a5a54); }
  .post-body > * + * { margin-top: 1.25rem; }
  .post-body h2 { margin-top: 2.75rem; font-family: var(--font-serif, 'Cormorant Garamond', serif); font-size: 2rem; line-height: 1.15; color: var(--color-forest-900, #0b2a22); }
  .post-body strong { color: var(--color-forest-900, #0b2a22); font-weight: 600; }
  .post-body ul, .post-body ol { padding-left: 0; list-style: none; }
  .post-body ul li { position: relative; padding-left: 1.5rem; margin-top: 0.5rem; }
  .post-body ul li::before { content: ''; position: absolute; left: 0; top: 0.8em; width: 7px; height: 7px; background: var(--color-gold-500, #b8975a); transform: rotate(45deg); }
  .post-body ol { counter-reset: n; }
  .post-body ol li { counter-increment: n; position: relative; padding-left: 2.25rem; margin-top: 0.75rem; }
  .post-body ol li::before { content: counter(n); position: absolute; left: 0; top: 0; font-family: var(--font-serif, serif); font-size: 1.5rem; line-height: 1.4; color: var(--color-gold-600, #a8843f); }
  .post-body a { color: var(--color-forest-900, #0b2a22); text-decoration: underline; text-underline-offset: 4px; }
  .post-body a:hover { color: var(--color-gold-700, #8a6a2c); }
  .post-body > p:first-of-type { font-size: 1.25rem; color: var(--color-forest-900, #0b2a22); }
</style>
