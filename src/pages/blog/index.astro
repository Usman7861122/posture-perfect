---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/react/Reveal';
import { site } from '../../data/site';
import { img } from '../../data/images';
import { sortedPosts, tags, fmtDate, postUrl } from '../../data/blog';

const bg = (list: string[]) => list.map((u) => `url(${u})`).join(', ');
const full = new Set(Object.keys(import.meta.glob('../../data/posts/*.md')).map((p) => p.split('/').pop()!.replace('.md', '')));
const href = (slug: string) => (full.has(slug) ? `/blog/${slug}/` : postUrl(slug));
const ext = (slug: string) => !full.has(slug);

const [featured, ...rest] = sortedPosts;
const title = 'Blog | Back Pain, Sciatica, Posture & Wellness Articles';
const desc = 'Articles from Dr. Yaron Lohr and the team at Posture Perfect Wellness Center on back pain, sciatica, posture, sports injuries and wellness.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Blog', name: 'Posture Perfect Wellness Center Blog', url: new URL('/blog/', Astro.site).toString(), description: desc };
const PAGE = 12;
---

<BaseLayout title={title} description={desc} jsonLd={jsonLd}>
  <section class="on-dark relative isolate overflow-hidden bg-forest-950 pb-16 pt-36 text-ivory-50 md:pb-24 md:pt-44">
    <div aria-hidden="true" class="parallax-fixed absolute inset-0 -z-20" style={`background-image: ${bg(img.phases)}`}></div>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-r from-forest-950/95 via-forest-950/80 to-forest-950/50"></div>
    <div class="container-page">
      <nav aria-label="Breadcrumb" class="text-xs uppercase tracking-[0.18em] text-ivory-200/70">
        <ol class="flex items-center gap-x-2">
          <li><a href="/" class="hover:text-gold-300">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gold-300" aria-current="page">Blog</li>
        </ol>
      </nav>
      <h1 class="mt-10 max-w-3xl text-[clamp(2.25rem,5vw,4.25rem)] leading-[1.05] text-ivory-50">Learn. Move. <em class="gold-text">Feel better.</em></h1>
      <span aria-hidden="true" class="my-7 block h-px w-32 bg-gradient-to-r from-gold-400 to-transparent"></span>
      <p class="max-w-xl text-base leading-relaxed text-ivory-100/85 sm:text-lg">Clear answers on pain, posture and wellness, from Dr. Lohr and our team.</p>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="section pb-0">
    <div class="container-page">
      <Reveal client:visible>
        <a href={href(featured.slug)} target={ext(featured.slug) ? '_blank' : undefined} rel={ext(featured.slug) ? 'noopener' : undefined} class="group grid overflow-hidden border border-forest-900/15 bg-ivory-50 transition-all duration-500 hover:border-gold-500 hover:shadow-[0_30px_60px_-35px_rgba(7,26,21,0.55)] md:grid-cols-[1.1fr_1fr]">
          <span class="relative block min-h-[260px] overflow-hidden bg-forest-800">
            {featured.image && <img src={featured.image} alt="" loading="eager" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-luxe)] group-hover:scale-105" onerror="this.style.display='none'" />}
          </span>
          <span class="flex flex-col justify-center p-8 sm:p-12">
            <span class="text-xs font-medium uppercase tracking-[0.25em] text-gold-700">Latest · {featured.tag}</span>
            <span class="mt-3 block font-serif text-3xl leading-tight text-forest-900 sm:text-4xl">{featured.title}</span>
            <span class="mt-4 block text-base leading-relaxed text-muted">{featured.excerpt}</span>
            <span class="mt-6 block text-xs uppercase tracking-[0.18em] text-muted">{fmtDate(featured.date)}</span>
            <span class="mt-6 inline-flex items-center gap-3 text-sm font-medium uppercase tracking-[0.2em] text-forest-900 transition-colors group-hover:text-gold-700">Read article <span aria-hidden="true" class="transition-transform duration-500 group-hover:translate-x-2">→</span></span>
          </span>
        </a>
      </Reveal>
    </div>
  </section>

  <!-- FILTER + GRID -->
  <section class="section">
    <div class="container-page">
      <div role="group" aria-label="Filter articles by topic" class="flex flex-wrap justify-center gap-2" id="blog-filters">
        <button type="button" data-tag="All" aria-pressed="true" class="blog-chip">All</button>
        {tags.map((t) => <button type="button" data-tag={t} aria-pressed="false" class="blog-chip">{t}</button>)}
      </div>

      <ul id="blog-grid" class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((p) => (
          <li data-tag={p.tag} class="blog-card">
            <a href={href(p.slug)} target={ext(p.slug) ? '_blank' : undefined} rel={ext(p.slug) ? 'noopener' : undefined} class="group flex h-full flex-col overflow-hidden border border-forest-900/15 bg-ivory-50 transition-all duration-500 hover:-translate-y-1 hover:border-gold-500 hover:shadow-[0_24px_50px_-30px_rgba(7,26,21,0.5)]">
              <span class="relative block aspect-[16/10] overflow-hidden bg-forest-900">
                <span aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_30%,rgba(184,151,90,0.35),transparent_60%)]"></span>
                {p.image && <img src={p.image} alt="" loading="lazy" width="640" height="400" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-luxe)] group-hover:scale-105" onerror="this.style.display='none'" />}
                <span class="absolute left-4 top-4 bg-forest-950/85 px-3 py-1.5 text-[10px] font-medium uppercase tracking-[0.2em] text-gold-300">{p.tag}</span>
              </span>
              <span class="flex flex-1 flex-col p-6">
                <span class="text-xs uppercase tracking-[0.18em] text-muted">{fmtDate(p.date)}</span>
                <span class="mt-3 block font-serif text-2xl leading-snug text-forest-900 transition-colors group-hover:text-gold-700">{p.title}</span>
                <span class="mt-3 block flex-1 text-sm leading-relaxed text-muted">{p.excerpt}</span>
                <span class="mt-5 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.2em] text-forest-900 group-hover:text-gold-700">Read <span aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p id="blog-empty" class="mt-12 hidden text-center text-muted">No articles in this topic yet.</p>
      <div class="mt-12 text-center"><button type="button" id="blog-more" class="btn-dark">Show more articles</button></div>
    </div>
  </section>

  <section class="on-dark relative isolate overflow-hidden py-16 text-center text-ivory-50 md:py-24">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-forest-900"></div>
    <Reveal client:visible className="container-page max-w-3xl">
      <h2 class="display !text-ivory-50">Have a question <em class="gold-text">about your pain?</em></h2>
      <p class="lead mt-6">Reading helps. A real exam helps more. Book a visit and leave with a plan.</p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/contact" class="btn-gold btn-book">Schedule an Evaluation</a>
        <a href={site.phoneHref} class="btn-outline-light">Call {site.phone}</a>
      </div>
    </Reveal>
  </section>
</BaseLayout>

<style is:global>
  .blog-chip { border: 1px solid rgb(11 42 34 / 0.2); background: var(--color-ivory-50, #fbf8f1); color: var(--color-forest-900, #0b2a22); padding: 0.625rem 1.25rem; font-size: 0.875rem; transition: all 0.3s; }
  .blog-chip:hover { border-color: var(--color-gold-500, #b8975a); }
  .blog-chip[aria-pressed='true'] { background: var(--color-forest-900, #0b2a22); border-color: var(--color-forest-900, #0b2a22); color: var(--color-ivory-50, #fbf8f1); }
  .blog-card[hidden] { display: none; }
</style>

<script define:vars={{ PAGE }}>
  const cards = [...document.querySelectorAll('.blog-card')];
  const chips = [...document.querySelectorAll('.blog-chip')];
  const more = document.getElementById('blog-more');
  const empty = document.getElementById('blog-empty');
  let tag = 'All';
  let shown = PAGE;
  function render() {
    const match = cards.filter((c) => tag === 'All' || c.dataset.tag === tag);
    cards.forEach((c) => (c.hidden = true));
    match.slice(0, shown).forEach((c) => (c.hidden = false));
    more.hidden = match.length <= shown;
    empty.classList.toggle('hidden', match.length > 0);
  }
  chips.forEach((b) => b.addEventListener('click', () => {
    tag = b.dataset.tag; shown = PAGE;
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    render();
  }));
  more.addEventListener('click', () => { shown += PAGE; render(); });
  render();
</script>
